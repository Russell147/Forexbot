ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://forexpilot:forexpilot@localhost:5432/forexpilot
# Read-only engine status API on the MT5 machine. The backend polls /health here.
ENGINE_API_URL=http://127.0.0.1:8001
CORS_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=false
# Cross-site frontend (Vercel -> VPS) needs COOKIE_SECURE=true and COOKIE_SAMESITE=none (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
