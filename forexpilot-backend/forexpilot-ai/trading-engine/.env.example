# Must point at the SAME database as the API.
DATABASE_URL=postgresql+psycopg2://forexpilot:forexpilot@YOUR_DB_HOST:5432/forexpilot

# MT5 credentials live ONLY here (never in the database or the browser).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe. Use single quotes on Windows so \t is not escaped.
# MT5_PATH='C:\Program Files\MetaTrader 5\terminal64.exe'
MT5_PATH=
# e.g. "m" if your broker uses EURUSDm
SYMBOL_SUFFIX=

# Safety: the engine refuses to trade a LIVE account unless this is true.
ALLOW_LIVE=false

POLL_SECONDS=5

# Read-only status API polled by the FastAPI backend (no credentials are exposed).
ENGINE_API_HOST=127.0.0.1
ENGINE_API_PORT=8001
MAGIC_NUMBER=240611
MAX_DEVIATION_POINTS=20

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MIN_CONFIDENCE=0.7
